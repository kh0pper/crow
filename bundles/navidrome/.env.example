# Navidrome connection
# Crow creates the first admin (`admin`) at install and keeps its password in
# Settings → Passwords of the Crow's Nest; it writes both values here.
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=

# Docker mode only — host path for music files
# NAVIDROME_MUSIC_PATH=/path/to/music   (example — set your own)
