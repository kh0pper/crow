# Jellyfin connection
# Crow finishes Jellyfin's setup wizard at install and keeps the admin login in
# Settings → Passwords of the Crow's Nest.
# Get an API key from Jellyfin Dashboard > API Keys
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Docker mode only — host paths for media and config
# JELLYFIN_MEDIA_PATH=/path/to/media   (example — set your own)
JELLYFIN_CONFIG_PATH=
