# BookStack connection
# Create an API token in BookStack: Settings > API Tokens
BOOKSTACK_URL=http://localhost:6875
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Docker mode only — MariaDB password (default: bookstack)
BOOKSTACK_DB_PASSWORD=

# Docker mode only — Laravel application key. Crow generates it; never leave it blank when starting by hand.
# An empty one makes compose fail (":?Set BOOKSTACK_APP_KEY").
BOOKSTACK_APP_KEY=
