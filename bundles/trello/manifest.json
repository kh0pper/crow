{
  "id": "trello",
  "name": "Trello",
  "version": "1.0.0",
  "description": "Board and card management",
  "type": "mcp-server",
  "author": "Crow",
  "category": "productivity",
  "tags": [
    "trello",
    "boards",
    "tasks"
  ],
  "icon": "kanban",
  "server": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-server-trello"
    ],
    "envKeys": [
      "TRELLO_API_KEY",
      "TRELLO_TOKEN"
    ]
  },
  "env_vars": [
    {
      "name": "TRELLO_API_KEY",
      "description": "Trello API key",
      "required": true,
      "secret": true
    },
    {
      "name": "TRELLO_TOKEN",
      "description": "Trello token",
      "required": true,
      "secret": true
    }
  ],
  "connect": {
    "method": "token",
    "group": "paste",
    "fields": [
      {
        "name": "TRELLO_API_KEY",
        "kind": "secret",
        "label_key": "services.field.TRELLO_API_KEY"
      },
      {
        "name": "TRELLO_TOKEN",
        "kind": "secret",
        "label_key": "services.field.TRELLO_TOKEN"
      }
    ],
    "steps": [
      "services.steps.trello.1",
      "services.steps.trello.2",
      "services.steps.trello.3"
    ],
    "test": {
      "kind": "http",
      "url": "https://api.trello.com/1/members/me?key=${TRELLO_API_KEY}&token=${TRELLO_TOKEN}",
      "expect": [
        200
      ]
    }
  },
  "ports": [],
  "webUI": null
}
