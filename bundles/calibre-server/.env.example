# Calibre content server connection
# The URL where the Calibre content server is accessible
# (the bundle's own server answers here, with a login required)
CALIBRE_URL=http://localhost:8081

# Host path to your Calibre library folder (required for Docker mode)
# CALIBRE_LIBRARY_PATH=/path/to/calibre/library   (example — set your own)

# Login for the content server. Crow creates the `admin` account at install and
# writes its username and the password it generated here; the password is also kept
# in Settings → Passwords. Set these yourself only when you connect to a server that
# already has its own users.
CALIBRE_USERNAME=admin
CALIBRE_PASSWORD=