  "steps": [
    {
      "text": "Stand with your feet shoulder-width apart and your arms reaching forward.",
      "cue": "Feet shoulder-width, arms forward.",
      "at": 0
    },
    {
      "text": "Bend your knees and lower yourself a little, about a hand's width.",
      "cue": "Bend your knees a little.",
      "at": 1
    },
    {
      "text": "Stand back up. Keep your heels down and your knees pointing the same way as your toes.",
      "cue": "Stand up. Heels down, knees over toes.",
      "at": 0
    },
    {
      "text": "Repeat slowly and smoothly.",
      "cue": "Slow and smooth.",
      "at": 1
    }
  ],
