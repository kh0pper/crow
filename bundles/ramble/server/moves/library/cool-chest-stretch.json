  "steps": [
    {
      "text": "Stand tall with your shoulders relaxed.",
      "cue": "Stand tall, shoulders relaxed.",
      "at": 0
    },
    {
      "text": "Reach your arms back and out to the sides, a little away from your body, with your thumbs turned out.",
      "cue": "Arms back and out, thumbs turned out.",
      "at": 1
    },
    {
      "text": "Gently lift your chest forward and up until you feel a stretch across it.",
      "cue": "Lift your chest. Feel it open.",
      "at": 1
    },
    {
      "text": "Hold and breathe slowly. Keep your chin level.",
      "cue": "Hold and breathe. Chin level.",
      "at": 1
    }
  ],
  "works": [
    "Upper back"
  ],
  "stretches": [
    "Chest",
    "Front of the shoulders"
  ],
  "mistakes": [
    "Arching the lower back to get further.",
    "Pushing the chin forward."
  ],
  "regression": "Keep your hands on your hips and just draw your elbows back a little.",
  "stopIf": "Stop if you feel pinching in your shoulders, or tingling in your arms.",
  "skipIf": [
    "shoulder"
  ],
