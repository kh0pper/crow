  "steps": [
    {
      "text": "Hold the band in front of you with both hands and your arms straight at chest height.",
      "cue": "Band in front, arms straight at chest height.",
      "at": 0
    },
    {
      "text": "Set your hands about shoulder-width apart so the band is slightly tight.",
      "cue": "Hands shoulder-width, band slightly tight.",
      "at": 0
    },
    {
      "text": "Pull the band apart until your arms open wide, keeping your shoulders down.",
      "cue": "Pull the band apart. Shoulders down.",
      "at": 1
    },
    {
      "text": "Return slowly to the start.",
      "cue": "Return slowly.",
      "at": 0
    }
  ],
