  "steps": [
    {
      "text": "Stand tall with your arms relaxed by your sides.",
      "cue": "Stand tall, arms relaxed.",
      "at": 0
    },
    {
      "text": "Lift both shoulders toward your ears, roll them back, and let them drop.",
      "cue": "Shoulders up, back, and down.",
      "at": 0
    },
    {
      "text": "Do five slow rolls backward, then five forward.",
      "cue": "Five slow rolls back, then five forward.",
      "at": 0
    },
    {
      "text": "Keep your neck long and your breathing easy.",
      "cue": "Neck long. Easy breathing.",
      "at": 0
    }
  ],
  "works": [
    "Shoulders",
    "Upper back"
  ],
  "stretches": [
    "Neck",
    "Chest"
  ],
  "mistakes": [
    "Rolling fast and jerking the neck.",
    "Holding your breath."
  ],
  "regression": "Make the circles smaller, or roll one shoulder at a time.",
  "stopIf": "Stop if you feel pinching or pain in your shoulders or neck.",
