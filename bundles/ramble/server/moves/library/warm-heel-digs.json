  "steps": [
    {
      "text": "Stand tall with your feet hip-width apart and your knees soft.",
      "cue": "Stand tall, knees soft.",
      "at": 0
    },
    {
      "text": "Reach one heel forward and tap it on the floor with your toes pointing up.",
      "cue": "Tap one heel forward, toes up.",
      "at": 1
    },
    {
      "text": "Bring it back and tap the other heel forward. Keep the standing knee a little bent.",
      "cue": "Change legs. Standing knee soft.",
      "at": 1
    },
    {
      "text": "Keep a steady rhythm. Bend and straighten your arms in time if you like.",
      "cue": "Steady rhythm. Arms join in if you like.",
      "at": 1
    }
  ],
  "works": [
    "Legs",
    "Heart and lungs"
  ],
  "stretches": [
    "Back of the thigh"
  ],
  "mistakes": [
    "Locking the standing knee.",
    "Leaning back as the heel reaches forward."
  ],
  "regression": "Take smaller taps and rest one hand on a wall.",
  "stopIf": "Stop if you feel pain in your knees or ankles, or feel dizzy.",
