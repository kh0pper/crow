    {
      "text": "Stand on the middle of the band and hold one end in each hand at shoulder height.",
      "cue": "Stand on the band, hands at shoulder height.",
      "at": 0
    },
    {
      "text": "Keep your ribs down and your belly gently firm.",
      "cue": "Ribs down, belly gently firm.",
      "at": 0
    },
    {
      "text": "Press both hands overhead until your arms are long.",
      "cue": "Press both hands overhead.",
      "at": 1
    },
    {
      "text": "Lower slowly back to shoulder height.",
      "cue": "Lower slowly to shoulder height.",
      "at": 0
    }
