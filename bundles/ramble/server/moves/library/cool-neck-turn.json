  "steps": [
    {
      "text": "Stand or sit tall and look straight ahead.",
      "cue": "Tall, eyes ahead.",
      "at": 0
    },
    {
      "text": "Slowly turn your head toward one shoulder as far as is comfortable.",
      "cue": "Turn your head slowly to one side.",
      "at": 0
    },
    {
      "text": "Hold for a few seconds. Keep your shoulders down and still.",
      "cue": "Hold. Shoulders down.",
      "at": 0
    },
    {
      "text": "Come back to the middle, then turn the other way.",
      "cue": "Back to the middle.",
      "say": "Come back to the middle.",
      "at": 0
    }
  ],
  "works": [
