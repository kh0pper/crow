      "text": "Stand an arm's length from a wall and place both palms on it at shoulder height.",
      "cue": "Palms on the wall at shoulder height.",
      "at": 0
    },
    {
      "text": "Walk your feet back a little so your body is in one straight line.",
      "cue": "Feet back a little, body in one line.",
      "at": 0
    },
    {
      "text": "Bend your elbows to bring your chest toward the wall.",
      "cue": "Bend your elbows. Chest toward the wall.",
      "at": 1
    },
    {
      "text": "Push back out to straight arms.",
      "cue": "Push back to straight arms.",
      "at": 0
    }
