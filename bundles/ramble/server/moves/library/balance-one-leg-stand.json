  "steps": [
    {
      "text": "Stand facing a wall with your fingertips resting on it.",
      "cue": "Face the wall, fingertips on it.",
      "at": 0
    },
    {
      "text": "Lift one foot a little off the floor. Keep your hips level.",
      "cue": "Lift one foot. Hips level.",
      "at": 1
    },
    {
      "text": "Stand tall on the other leg with that knee soft.",
      "cue": "Stand tall. Standing knee soft.",
      "at": 1
    },
    {
      "text": "Hold and breathe, then lower the foot and change legs.",
      "cue": "Hold and breathe.",
      "say": "Hold and breathe.",
      "at": 1
    }
  ],
  "works": [
    "Legs",
    "Hips"
  ],
