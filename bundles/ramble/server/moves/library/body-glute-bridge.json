      "text": "Lie on your back with your knees bent and your feet flat, hip-width apart.",
      "cue": "Lie on your back, knees bent, feet flat.",
      "at": 0
    },
    {
      "text": "Rest your arms along your sides.",
      "cue": "Arms along your sides.",
      "at": 0
    },
    {
      "text": "Push through your feet and lift your hips until your body makes a straight line.",
      "cue": "Push through your feet. Lift your hips.",
      "at": 1
    },
    {
      "text": "Hold for one breath, then lower slowly.",
      "cue": "Hold one breath, then lower slowly.",
      "at": 1
    }
