  "title": "Halfway lift",
  "minutes": 1,
  "level": 1,
  "indoor": true,
  "activity": "yoga",
  "equipment": ["none"],
  "tags": ["standing", "fold", "beginner"],
  "steps": [
    "Fold forward from your hips with a soft bend in your knees.",
    "Rest your hands on your shins and lengthen your back.",
    "Draw your shoulders away from your ears and look slightly ahead.",
    "Hold for a couple of breaths, then fold down or stand up slowly."
  ],
  "works": ["Back"],
  "stretches": ["Hamstrings", "Calves"],
  "mistakes": [
    "Rounding the back instead of lengthening it.",
    "Pulling hard on the shins."
  ],
  "skipIf": ["lower_back"],
  "easier": "yoga-mountain",
  "harder": "yoga-forward-fold",
