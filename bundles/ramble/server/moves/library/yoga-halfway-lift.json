  "reviewed": false,
  "pose": {
    "neck": -15, "spine": 5,
    "shoulderL": 90, "elbowL": 15, "wristL": 10,
    "shoulderR": 90, "elbowR": 15, "wristR": 10,
    "hipL": 85, "kneeL": 10, "ankleL": 10,
    "hipR": 85, "kneeR": 10, "ankleR": 10,
    "rootAngle": 85,
    "support": "feet"
  }
