# Kavita connection
# Crow registers the first account (`admin`) at install and keeps its password in
# Settings → Passwords of the Crow's Nest; it writes both values here.
KAVITA_URL=http://localhost:5000
KAVITA_USERNAME=
KAVITA_PASSWORD=

# Docker mode only — host path for manga/comics/ebooks
# KAVITA_LIBRARY_PATH=/path/to/manga   (example — set your own)
