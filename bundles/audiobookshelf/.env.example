# Audiobookshelf connection
# Get an API token from Settings > Users > your user
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_API_KEY=

# Docker mode only — host paths for media
# AUDIOBOOKSHELF_AUDIOBOOK_PATH=/path/to/audiobooks   (example — set your own)
# AUDIOBOOKSHELF_PODCAST_PATH=/path/to/podcasts   (example — set your own)
