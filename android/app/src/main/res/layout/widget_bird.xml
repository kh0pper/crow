<?xml version="1.0" encoding="utf-8"?>
<!--
    "Your bird" home-screen widget (widgets phase 3).

    The bird image fills the cell and the caption sits over its lower edge: the drawing keeps padding
    around the bird itself, so a 1x1 cell still reads as a bird, and a 2x1 cell has room for the mood
    and the step count. BirdWidgetProvider sets the image (or the app icon when there is no bird) and
    hides the caption lines it has nothing to say for; keep the ids in step with it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ImageView
        android:id="@+id/widget_bird_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_bird_label"
        android:padding="2dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_bird_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/background"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_bird_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/background"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>