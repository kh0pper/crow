<?xml version="1.0" encoding="utf-8"?>
<!--
    The "What needs me" home-screen widget (widgets phase 1).

    RemoteViews cannot inflate a list without a RemoteViewsService, so the rows are five fixed slots:
    NeedsMeWidgetProvider shows the ones the summary has and sets the rest GONE, and does the same
    inside each row for its three button slots. Every id here is referenced by that provider; keep
    the two in step.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="8dp">

