# OPERATOR-EDITED TEMPLATE: install-runtime.sh renders User= (the installing
# user) and the /home/crow/crow checkout path for this host, and writes the
# per-instance /etc/crow/pibot-<i>.env this unit loads.
[Unit]
Description=Crow Bot Builder — gateway host (Telegram/Slack) [%i]
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crow
WorkingDirectory=/home/crow/crow
EnvironmentFile=/etc/crow/pibot-%i.env
ExecStart=/usr/bin/env node /home/crow/crow/scripts/pi-bots/gateways/gateway_runner.mjs
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
